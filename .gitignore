# Source PDFs — download via scripts, don't track
**/pdfs/
**/raw_pdfs/*.pdf

# Rendered PDF pages (intermediate OCR artifacts)
**/*_pages/

# Generated databases
*.sqlite
*.sqlite3
*.db
*.duckdb

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

